<?xml version="1.0"?>
<package format="3">
  <name>host_mission</name>
  <version>0.1.0</version>
  <description>Host-side mission coordination (queue, batch sequencing, per-robot dispatch); rovers plan and control.</description>
  <maintainer email="user@example.com">user</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>host_mission_interfaces</exec_depend>
  <exec_depend>host_planning</exec_depend>
  <exec_depend>host_sim</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>domain_bridge</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
