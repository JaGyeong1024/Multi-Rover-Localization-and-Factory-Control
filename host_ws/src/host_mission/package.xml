<?xml version="1.0"?>
<package format="3">
  <name>host_mission</name>
  <version>0.1.0</version>
  <description>Host-side mission coordination (fleet orchestration): mission queue, capacity-batch sequencing, per-robot target dispatch, leader-priority coordination. Host=조율 / rover=플래닝·제어.</description>
  <maintainer email="user@example.com">user</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>host_mission_interfaces</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>domain_bridge</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
